# AgriVerse AI Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=agriverse-super-secret-key-change-in-production

# Gemini API Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Models (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Application Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload
VECTOR_STORE_DIR=vector_store
DATABASE_PATH=database/agriverse.db
